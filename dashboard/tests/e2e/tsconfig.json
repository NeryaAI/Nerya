{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": false,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
