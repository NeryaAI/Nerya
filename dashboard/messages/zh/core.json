  "terms": {
    "vaultRef": {
      "label": "Vault 引用",
      "explain": "Nerya 安全保存 API 密钥的方式：密钥本身加密存放在本地保险库中，配置里只保留一个 vault:// 地址。配置时直接粘贴明文密钥即可，Nerya 会自动转换。"
    },
    "fetchModels": {
      "label": "拉取模型",
      "explain": "向你选择的服务商请求当前密钥可用的模型清单。粘贴密钥后先点这里，再勾选要让 Nerya 使用的模型。"
    },
    "tier": {
      "label": "模型档位",
      "explain": "决定“哪种活交给哪个模型”的槽位。重度分析用高档位，日常回复用中档位，轻量查询用低档位，意图识别负责理解消息属于哪类任务。同一个模型可以同时担任多个档位。"
    },
    "apiShape": {
      "label": "接口类型",
      "explain": "服务商 API 的“方言”。多数服务商兼容 OpenAI 格式，Anthropic 有自己的格式。一般保持自动检测即可，连接测试失败时再手动选择。"
    },
    "webhook": {
      "label": "Webhook",
      "explain": "一个由平台主动调用、把消息实时推送给 Nerya 的 URL。另一种方式是轮询：Nerya 每隔几秒主动查询新消息。"
    },
    "polling": {
      "label": "轮询",
      "explain": "Nerya 定时向平台查询新消息，而不是被动等待推送。无需公网地址、随处可用，代价是消耗少量查询配额。"
    },
    "capabilityGate": {
      "label": "能力开关",
      "explain": "针对整个功能域（交易、浏览器、网络等）的硬开关。关闭时，无论其他配置多完整，该功能都不会运行。"
    },
    "tunnel": {
      "label": "隧道",
      "explain": "一条安全通道，让运行在本机的 Nerya 能被外部网络访问，聊天平台才能把消息送达。"
    }
  },
