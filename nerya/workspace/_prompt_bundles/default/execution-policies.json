{
  "subagent_policy_profiles": {
    "bounded_research": {
      "max_iterations": 8,
      "max_wall_seconds": 360
    },
    "expert_web_delegate": {
      "preload_skills": ["research"],
      "native_tools": {
        "allow": [
          "skill_index",
          "skill_view",
          "research_run",
          "read_file",
          "market_data"
        ]
      }
    },
    "web_collector": {
      "preload_skills": ["research"],
      "locked_tier": "light",
      "allow_model_override": false,
      "max_iterations": 4,
      "max_skill_calls": 6,
      "max_wall_seconds": 180,
      "llm_max_attempts": 1,
      "native_tools": {
        "allow": [
          "skill_index",
          "skill_view",
          "script_inspect",
          "script_run",
          "read_file",
          "web_search",
          "web_fetch",
          "web_search_fetch"
        ]
      },
      "tool_argument_defaults": {
        "web_search": {"save_raw": true},
        "web_fetch": {"save_raw": true},
        "web_search_fetch": {"save_raw": true}
      }
    }
  },
