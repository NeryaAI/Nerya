"""LP contract behavior against installed SDKs and candidate-local companions.

All lp.snapshot.v1 observations, identities and amounts below are SYNTHETIC
unit fixtures, not history, wallet ownership, performance or live readiness.
Run from the candidate root: python -m pytest -o addopts='' tests/test_contract.py.
These tests never configure the saved manifest or authorize execution.
"""
from copy import deepcopy
from datetime import datetime, timezone
import json
from types import SimpleNamespace

import pytest

import main
from nerya.strategies import ResultBuilder, StrategyResult
from nerya.strategies.context import StrategyClock, StrategyState, StateStore
from nerya.strategies.input_context import StrategyInputContext


class NoFinancial:
    def __init__(self):
        self.calls = []

    def __getattr__(self, name):
        self.calls.append(name)
        raise AssertionError('synthetic paper fixture must not use financial: ' + name)


