def publish(ctx, seconds=0):
    now = ctx.clock.now().timestamp() + seconds
    ctx.clock.freeze(iso=datetime.fromtimestamp(now, timezone.utc).isoformat())
    for value in (ctx.snapshot, ctx.snapshot['account'], ctx.snapshot['economics']):
        value['as_of'] = now
    ctx.inputs.publish('source:synthetic-lp', ctx.snapshot, source='synthetic-unit-fixture-not-history')


def paper_decision(ctx):
    result = main.run(ctx)
    assert isinstance(result, StrategyResult)
    assert result.status.value == 'hold', result.asdict()
    assert result.metadata['financial_execution_allowed'] is False
    assert result.metadata['funds_sent'] is False
    assert ctx.financial.calls == []
    assert ctx.state.get('lp_operation') is None
    return result.metadata['lp_decision']


@pytest.mark.parametrize('case,action,reason', [
    ('entry', 'lp_add', 'configured_initial_entry'),
    ('hold', 'hold', 'inside_range'),
    ('collect', 'lp_collect', 'fee_collection_threshold'),
    ('exit', 'lp_remove', 'principal_floor_exit'),
    ('closed', 'lp_collect', 'remaining_fees'),
    ('cost', 'hold', 'fees_do_not_cover_execution'),
])
def test_paper_lifecycle(ctx, case, action, reason):
    position = ctx.snapshot['account']['positions'][0]
    if case == 'entry':
        ctx.config.params['lp_source']['token_id'] = None
        ctx.snapshot['account']['positions'] = []
    if case in {'collect', 'closed', 'cost'}:
        position['owed_value_usd'] = '2'
    if case == 'exit':
        position['principal_value_usd'] = '4'
    if case == 'closed':
        position['liquidity'] = '0'
    if case == 'cost':
        ctx.snapshot['economics']['total_execution_cost_usd'] = '2'
    publish(ctx)
    decision = paper_decision(ctx)
    assert (decision['action'], decision['reason']) == (action, reason)


def test_persistence_and_cooldown_use_saved_state(ctx, tmp_path):
    ctx.snapshot['account']['positions'][0]['pool']['tick'] = 100
    publish(ctx)
    assert paper_decision(ctx)['reason'] == 'range_exit_first_observed'
    saved = json.loads((tmp_path / 'state.json').read_text())['lp_policy_state:paper']
    assert saved['outside_since'] == ctx.clock.now().timestamp()
    ctx.state = StrategyState(StateStore(tmp_path / 'state.json'))
    publish(ctx, 9)
    assert paper_decision(ctx)['reason'] == 'range_exit_not_persistent'
    publish(ctx, 1)
    assert paper_decision(ctx)['action'] == 'lp_rebalance'
    ctx.state.set('lp_policy_state:paper', {**saved, 'last_rebalance': ctx.clock.now().timestamp()})
    publish(ctx, 1)
    assert paper_decision(ctx)['reason'] == 'rebalance_cooldown'
    publish(ctx, 99)
    assert paper_decision(ctx)['action'] == 'lp_rebalance'
    ctx.snapshot['account']['positions'][0]['pool']['tick'] = 0
    publish(ctx)
    assert paper_decision(ctx)['reason'] == 'inside_range'
    assert ctx.state.get('lp_policy_state:paper')['outside_since'] is None


@pytest.mark.parametrize('damage', ['source', 'binding', 'units', 'tokens', 'stale'])
def test_invalid_observations_fail_closed(ctx, damage):
    publish(ctx)
    snapshot = deepcopy(ctx.snapshot)
    if damage == 'source':
        ctx.config.params['lp_source']['source_id'] = 'unpublished-synthetic-source'
    elif damage == 'binding':
        snapshot['account']['component_binding']['revision'] = 'other-synthetic-revision'
    elif damage == 'units':
        snapshot['account']['positions'][0]['pool']['decimals'] = [6, 18]
    elif damage == 'tokens':
        snapshot['account']['positions'][0]['pool']['underlying_tokens'].reverse()
    else:
        snapshot['as_of'] -= 61
    ctx.inputs.publish('source:synthetic-lp', snapshot)
    result = main.run(ctx)
    assert isinstance(result, StrategyResult)
    assert result.status.value == 'error'
    assert result.error_kind == 'data_error'
    assert ctx.financial.calls == []
    assert ctx.state.get('lp_operation') is None


class RecoveryFinancial:
    """Signature-strict synthetic receipts only; no gateway, signing or wallet."""
    def __init__(self, state):
        self.state, self.calls = state, []

    def get(self, action_id):
        self.calls.append(('get', action_id))
        return dict(action_id=action_id, state=self.state)

    def prepare(self, request, *, client_request_id):
        self.calls.append(('prepare', deepcopy(request), client_request_id))
        return dict(action_id='synthetic-action', state='prepared', quote_hash='synthetic-quote')

    def reconcile(self, action_id):
        self.calls.append(('reconcile', action_id))
        return dict(action_id=action_id, state='confirmed')


@pytest.mark.parametrize('state', ['submitted', 'prepared', 'failed', 'interrupted_prepare'])
def test_live_recovery_preserves_original_identity_before_new_inputs(ctx, tmp_path, state):
    ctx.mode = 'live'
    # Empty real inputs and config must not prevent recovery or trigger a new cycle.
    ctx.config.params = {}
    ctx.financial = RecoveryFinancial(state)
    saved = dict(key='lp:synthetic-original', cycle='synthetic-original', kind='lp_add',
                 payload={'synthetic_frozen_request': True})
    if state != 'interrupted_prepare':
        saved['action_id'] = 'synthetic-action'
    ctx.state.set('lp_operation', saved)
    ctx.state = StrategyState(StateStore(tmp_path / 'state.json'))
    result = main.run(ctx)
    assert isinstance(result, StrategyResult)
    expected = [('prepare', saved['payload'], saved['key'])] if state == 'interrupted_prepare' else [
        ('get', 'synthetic-action')]
    if state == 'submitted':
        expected.append(('reconcile', 'synthetic-action'))
    assert ctx.financial.calls == expected
    assert result.status.value == ('ok' if state == 'submitted' else 'error' if state == 'failed' else 'hold')
    persisted = json.loads((tmp_path / 'state.json').read_text())['lp_operation']
    assert persisted == {**saved, 'action_id': 'synthetic-action'}
    if state == 'submitted':
        timing = ctx.state.get('lp_policy_state:live')
        assert timing['completed_key'] == saved['key']
        assert timing['last_rebalance'] == ctx.clock.now().timestamp()
    assert ctx.inputs.snapshot() == {}


class RebalanceRecovery:
    def __init__(self):
        self.calls = []

    def get_rebalance(self, rebalance_id):
        self.calls.append(('get', rebalance_id))
        return dict(rebalance_id=rebalance_id, state='waiting', revision=3,
                    cursor='exit', action_ids=['synthetic-exit'])

    def advance_rebalance(self, rebalance_id, *, expected_revision):
        self.calls.append(('advance', rebalance_id, expected_revision))
        return dict(rebalance_id=rebalance_id, state='completed', revision=4,
                    cursor='done', action_ids=['synthetic-exit', 'synthetic-entry'])


def test_saved_rebalance_uses_real_companion_and_original_revision(ctx):
    ctx.mode = 'live'
    ctx.config.params = {}
    ctx.financial = RebalanceRecovery()
    saved = dict(key='lp:synthetic-cycle', cycle='synthetic-cycle',
                 kind='lp_rebalance', payload={'synthetic_frozen_plan': True})
    ctx.state.set('lp_operation', saved)
    ctx.state.set('lp_rebalance:' + saved['key'], 'synthetic-rebalance')
    result = main.run(ctx)
    assert isinstance(result, StrategyResult)
    assert result.status.value == 'ok'
    assert result.metadata['state'] == 'completed'
    assert result.metadata['action_ids'] == ['synthetic-exit', 'synthetic-entry']
    assert ctx.financial.calls == [('get', 'synthetic-rebalance'), ('advance', 'synthetic-rebalance', 3)]
    assert ctx.state.get('lp_operation') == saved
    assert ctx.state.get('lp_policy_state:live')['completed_key'] == saved['key']
    assert ctx.inputs.snapshot() == {}
