# @nerya.version 1
# @nerya.title Configured Aave deposit rate policy
# @nerya.description Pure unit-denominated entry/exit decisions for one declared rate source.
# @nerya.logic Enter when flat at or above entry rate; exit all supplied units at or below exit rate.
# @nerya.rationale Hysteresis avoids repeated entries; allocation is a per-entry unit cap.
# @nerya.scope Pure decisions only; no execution, accounting, accrual or provider access.
# @nerya.input rate_policy, rate_source, UTC observation, supplied/cash units and injected cutoff.
# @nerya.output action, amount_units, observation_timestamp and the explicitly configured APY or APR metric.
# @nerya.risk Annualized rates are not realized return or an ownership attestation.
# @nerya.validation Exercise this callable and the copied main.py with synthetic offline inputs.

from collections.abc import Mapping
from datetime import datetime, timedelta
from math import isfinite
import re


class RatePolicyError(ValueError):
    """Invalid caller configuration or unavailable rate/position evidence."""

    def __init__(self, message, *, kind='data_error'):
        super().__init__(message)
        self.kind = kind


def _object(value, name, *, kind='data_error'):
    if not isinstance(value, Mapping):
        raise RatePolicyError(f'{name} must be a mapping', kind=kind)
    return value


def _number(value, name, *, kind='data_error'):
    try:
        valid = type(value) in (int, float) and isfinite(value) and value >= 0
    except OverflowError:
        valid = False
    if not valid:
        raise RatePolicyError(f'{name} must be a finite nonnegative number', kind=kind)
    return value


def _utc(value):
    if isinstance(value, str):
        if not re.fullmatch(
            r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,6})?(?:Z|\+00:00)',
            value,
        ):
            raise RatePolicyError('Timestamp must be a UTC ISO timestamp')
        try:
            value = datetime.fromisoformat(value.replace('Z', '+00:00'))
        except ValueError as exc:
            raise RatePolicyError('Invalid UTC timestamp') from exc
    if not isinstance(value, datetime) or value.utcoffset() != timedelta(0):
        raise RatePolicyError('Clock and observation must be UTC')
    return value


def _rate_fields(source):
    source = _object(source, 'rate_source', kind='configuration_required')
    metric = source.get('rate_metric', 'deposit_apy_percent')
    if metric == 'deposit_apy_percent':
        return metric, 'entry_apy_percent', 'exit_apy_percent', 'apy_percent'
    if metric == 'base_supply_rate_percent':
        return metric, 'entry_apr_percent', 'exit_apr_percent', metric
    raise RatePolicyError('Unsupported explicit rate_metric', kind='configuration_required')


def validate_rate_observation(*, policy, source, observation, as_of):
    """Validate the shared config/feed boundary without assuming a position."""
    policy = _object(policy, 'rate_policy', kind='configuration_required')
    source = _object(source, 'rate_source', kind='configuration_required')
    metric, entry, exit_rate, _ = _rate_fields(source)
    if metric == 'base_supply_rate_percent' and any(
        key in policy for key in ('entry_apy_percent', 'exit_apy_percent')
    ):
        raise RatePolicyError('APR mode requires APR policy fields, never APY aliases',
                              kind='configuration_required')
    for key in (entry, exit_rate, 'max_age_seconds', 'allocation_units'):
        _number(policy.get(key), key, kind='configuration_required')
    if policy[entry] <= policy[exit_rate]:
        raise RatePolicyError(f'{entry} must exceed {exit_rate}',
                              kind='configuration_required')
    observation = _object(observation, 'rate_observation')
    for key in ('pool_id', 'chain', 'asset', 'project'):
        if not isinstance(source.get(key), str) or not source[key].strip():
            raise RatePolicyError(f'rate_source.{key} is required', kind='configuration_required')
        if observation.get(key) != source[key]:
            raise RatePolicyError(f'Rate source identity mismatch: {key}')
    _number(observation.get(metric), metric)
    if not isinstance(observation.get('timestamp'), str):
        raise RatePolicyError('Observation timestamp must be UTC ISO text')
    stamp, cutoff = _utc(observation['timestamp']), _utc(as_of)
    if not 0 <= (cutoff - stamp).total_seconds() <= policy['max_age_seconds']:
        raise RatePolicyError('Rate observation is future or stale at the cutoff')
    return stamp.isoformat().replace('+00:00', 'Z')


def select_rate_observation(*, snapshot, source, as_of):
    """Adapt declared inputs.source rows + _envelope.pool to the v1 input.

    The catalog calls the rate asset ``symbol``; this is not the ERC20
    address in financial_request. Do not infer a token binding from a symbol.
    Rows may be unordered: choose the latest timestamp <= the UTC clock,
    reject conflicting duplicates, and never fill a null latest rate from
    an older row. Future rows do not participate in the decision.
    """
    source = _object(source, 'rate_source', kind='configuration_required')
    snapshot = _object(snapshot, 'rate source snapshot')
    envelope = _object(snapshot.get('_envelope'), 'rate source envelope')
    pool = _object(envelope.get('pool'), 'rate source pool')
    identity = {key: pool.get('symbol' if key == 'asset' else key)
                for key in ('pool_id', 'chain', 'asset', 'project')}
    for key, value in identity.items():
        if not isinstance(value, str) or not value.strip() or value != source.get(key):
            raise RatePolicyError(f'Rate source envelope identity mismatch: {key}')
    cutoff = _utc(as_of)
    rows = snapshot.get('rows')
    if not isinstance(rows, (list, tuple)):
        raise RatePolicyError('Rate source rows must be a sequence')
    observed = {}
    for row in rows:
        row = _object(row, 'rate row')
        if not isinstance(row.get('timestamp'), str):
            raise RatePolicyError('Rate row timestamp must be UTC ISO text')
        stamp = _utc(row['timestamp'])
        if stamp > cutoff:
            continue
        for key, value in identity.items():
            if key in row and row[key] != value:
                raise RatePolicyError(f'Rate row identity mismatch: {key}')
        observation = {**identity, 'timestamp': stamp.isoformat().replace('+00:00', 'Z'),
                       'deposit_apy_percent': row.get('deposit_apy_percent')}
        if stamp in observed and observed[stamp] != observation:
            raise RatePolicyError('Conflicting rate observations at the same timestamp')
        observed[stamp] = observation
    if not observed:
        raise RatePolicyError('No rate observation at or before the cutoff')
    return observed[max(observed)]


# @nerya.step decide | Evaluate deposit rates | Emit one unit-denominated signal without mutating position.
def decide_aave_rate(*, policy, source, observation, position, as_of):
    """Return the exact configured metric decision; reject missing/invalid evidence.

    Config fields are mandatory, in percent/year and asset units, never USD.
    Enter only while flat, using min(allocation_units, cash_units). Exit the
    complete supplied balance, including host-accounted accrual; allocation
    never caps an exit. Host replay owns fills, fees, accrual and prior state.
    Zero allocation disables new entries without suppressing withdrawals.
    This pure policy does not adjust units for fees. The backtest entrypoint
    supplies deployable cash using the explicit rate_replay fee assumption.
    """
    stamp = validate_rate_observation(policy=policy, source=source,
                                      observation=observation, as_of=as_of)
    position = _object(position, 'lending_position')
    supplied = _number(position.get('supplied_units'), 'supplied_units')
    cash = _number(position.get('cash_units'), 'cash_units')
    metric, entry, exit_rate, output = _rate_fields(source)
    rate = observation[metric]
    action, units = 'hold', 0
    if supplied > 0 and rate <= policy[exit_rate]:
        action, units = 'lend_withdraw', supplied
    elif supplied == 0 and rate >= policy[entry]:
        units = min(policy['allocation_units'], cash)
        if units > 0:
            action = 'lend_supply'
    return {'action': action, 'amount_units': units,
            'observation_timestamp': stamp, output: rate}
