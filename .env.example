# Nerya environment template.
# Real secrets live inside the SecretVault (workspace/vault/secrets.enc),
# not in env vars. These are only adapter hints used at bootstrap.

NERYA_WORKSPACE=~/.nerya
NERYA_LIVE_TRADING=false
NERYA_LOG_LEVEL=INFO

# Optional: override the master passphrase used to seal the SecretVault.
# If unset Nerya derives one from the local keyring.
# NERYA_VAULT_PASSPHRASE=change-me

# Nerya runs as a self-contained Nerya-native runtime. It does not
# attach to any external agent runtime; external agents integrate
# through the MCP and ACP bridges only.
