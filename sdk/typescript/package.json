{
  "name": "@nerya/sdk",
  "version": "0.1.0",
  "description": "Nerya Trigger and Trading SDK for TypeScript / Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
