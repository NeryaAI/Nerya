[Unit]
Description=Nerya Agent management dashboard
After=network-online.target nerya.service
Wants=network-online.target
Requires=nerya.service

[Service]
Type=simple
User=nerya
Group=nerya
WorkingDirectory=/opt/nerya/agent/dashboard
EnvironmentFile=-/etc/nerya/nerya.env
Environment=NERYA_API=http://127.0.0.1:18317
Environment=HOSTNAME=127.0.0.1
Environment=PORT=18380
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 18380
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/nerya/agent/dashboard/.next

[Install]
WantedBy=multi-user.target
